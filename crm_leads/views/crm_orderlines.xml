<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="crm_lead_form_inherit_order_lines" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.order.lines</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Order Lines">
                    <field name="crm_order_line_ids" context="{'default_lead_id': id}">
                        <list editable="bottom">
                            <field name="product_id" required="1"/>
                            <field name="product_uom_qty"/>
                            <field name="product_uom"/>
                            <field name="price_unit"/>
                            <field name="price_subtotal" readonly="1"/>
                        </list>
                        <form>
                            <group>
                                <field name="product_id" required="1"/>
                                <field name="product_uom_qty"/>
                                <field name="product_uom"/>
                                <field name="price_unit"/>
                                <field name="price_subtotal" readonly="1"/>
                            </group>
                        </form>
                    </field>
                </page>
            </notebook>

            <xpath expr="//sheet/notebook/page[@name='internal_notes']" position="before">
                <group string="Quotation">
                    <field name="sale_order_id" readonly="1"
                           options="{'no_open': False}"
                           context="{'form_view_ref': 'sale.view_order_form'}"/>
                </group>
            </xpath>

            <!-- Add Button to Create Quotation -->

        </field>
    </record>
</odoo>
